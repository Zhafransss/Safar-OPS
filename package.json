    "db:seed-dev": "node scripts/seed-dev.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.106.0",
    "@trpc/client": "^11.24.0",
    "@trpc/server": "^11.24.0",
    "@trpc/tanstack-react-query": "^11.24.0",
    "aws4fetch": "^1.0.20",
    "browser-image-compression": "^2.0.2",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",

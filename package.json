    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },

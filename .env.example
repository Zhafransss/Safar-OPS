# Pooled connection used by the app at runtime.
DATABASE_URL=
# Direct connection used by Prisma migrations.
DIRECT_URL=
# Photos: Cloudflare R2 when R2_BUCKET is set (required on Vercel), otherwise a local folder (docs/DEPLOY.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PHOTO_STORAGE_DIR=
JUBELIO_BASE_URL=https://api2.jubelio.com
# Only needed if a Jubelio user-list endpoint is confirmed (docs/DESIGN.md 4.2, option A).
JUBELIO_SERVICE_EMAIL=
JUBELIO_SERVICE_PASSWORD=
# Local development only, see README. Never set this on staging or production.
DEV_LOGIN_PASSWORD=
# Test accounts that skip Jubelio, as a JSON array (docs/DEPLOY.md). Hashes from `pnpm hash-password`.
LOCAL_ACCOUNTS=

# Pooled connection used by the app at runtime.
DATABASE_URL=
# Direct connection used by Prisma migrations.
DIRECT_URL=
# Photo storage: a folder on disk, or Vercel Blob once that driver exists (docs/DESIGN.md 4.4).
PHOTO_STORAGE_DIR=
BLOB_READ_WRITE_TOKEN=
JUBELIO_BASE_URL=https://api2.jubelio.com
# Only needed if a Jubelio user-list endpoint is confirmed (docs/DESIGN.md 4.2, option A).
JUBELIO_SERVICE_EMAIL=
JUBELIO_SERVICE_PASSWORD=
# Local development only, see README. Never set this on staging or production.
DEV_LOGIN_PASSWORD=
